// things/people_counter.things
// MQTT Binding – People Counter (Xtion Pro)
//
// Mosquitto runs locally on the Pi with TLS (port 8883) and authentication.
// The ca.crt file must be located on the openHAB host, e.g.:
//   /etc/openhab/certs/people_counter_ca.crt
//
// Copy the certificate from the Pi (one-time):
//   scp pi@peoplecounter.local:/etc/mosquitto/certs/ca.crt \
//       /etc/openhab/certs/people_counter_ca.crt
//   sudo chown openhab:openhab /etc/openhab/certs/people_counter_ca.crt

// ── Broker ────────────────────────────────────────────────────────────────────
mqtt:broker:peoplecounter "People Counter Broker" [
    host              = "peoplecounter.local",
    port              = 8883,
    secure            = true,
    certificatepin    = false,
    publickeypin      = false,
    keystore          = "/etc/openhab/certs/people_counter_ca.crt",
    keystorepwd       = "",
    username          = "peoplecounter",
    password          = "changeme",
    clientid          = "openhab_people_counter",
    keepalive         = 60,
    reconnectTime     = 5000
]

// ── Thing ─────────────────────────────────────────────────────────────────────
Thing mqtt:topic:peoplecounter:xtion "People Counter Xtion Pro" (mqtt:broker:peoplecounter) [
    availabilityTopic   = "people_counter/status",
    payloadAvailable    = "online",
    payloadNotAvailable = "offline"
] {
    Channels:
        // Current number of people (smoothed, median)
        Type number : count "Person Count" [
            stateTopic = "people_counter/count",
            retained   = true
        ]

        // Online/offline status of the counter
        Type string : status "Counter Status" [
            stateTopic = "people_counter/status",
            retained   = true
        ]
}
